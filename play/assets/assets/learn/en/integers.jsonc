// Learn lesson (English). Worked examples are checked by the tests:
// every "math" line must be true, and the last one must give the answer.
{
  "category": "integers",
  "title": "Negative numbers",
  "summary": "Work out the size first, then the sign.",
  "pages": [
    {
      "kind": "idea",
      "title": "Same signs, different signs",
      "text": "When you multiply or divide, two equal signs give a positive result and two different signs a negative one. Work out the size first, then add the sign.",
      "example": {
        "problem": "(−6) × (−4)",
        "steps": [
          {
            "math": "6 × 4 = 24",
            "note": "Size first"
          },
          {
            "math": "(−6) × (−4) = 24",
            "note": "Two minus signs: positive"
          }
        ],
        "answer": "24"
      }
    },
    {
      "kind": "idea",
      "title": "Adding and taking away",
      "text": "Taking away a negative number is adding it: 5 − (−3) = 5 + 3. To add numbers with different signs, take the smaller size from the bigger one and keep the sign of the bigger one.",
      "example": {
        "problem": "−9 + 4",
        "steps": [
          {
            "math": "9 − 4 = 5",
            "note": "Sizes: the smaller from the bigger"
          },
          {
            "math": "−9 + 4 = −5",
            "note": "−9 is bigger in size: the result is negative"
          }
        ],
        "answer": "−5"
      }
    },
    {
      "kind": "trick",
      "title": "Count the minus signs",
      "text": "In a long product, count the minus signs: an even number of them gives +, an odd number gives −.",
      "example": {
        "problem": "(−2) × 3 × (−5)",
        "steps": [
          {
            "math": "2 × 3 × 5 = 30",
            "note": "Sizes"
          },
          {
            "math": "(−2) × 3 × (−5) = 30",
            "note": "Two minus signs, an even number: positive"
          }
        ],
        "answer": "30"
      }
    },
    {
      "kind": "watchOut",
      "title": "Powers of a negative number",
      "text": "(−3)² multiplies −3 by itself: 9. An odd power of a negative number stays negative: (−2)³ = −8.",
      "example": {
        "problem": "(−2)³",
        "steps": [
          {
            "math": "(−2)³ = (−2) × (−2) × (−2)"
          },
          {
            "math": "(−2) × (−2) × (−2) = −8",
            "note": "Three minus signs: negative"
          }
        ],
        "answer": "−8"
      }
    }
  ],
  "tip": "Size first, then the sign: same signs give +, different signs give −."
}
