// Learn lesson (English). Worked examples are checked by the tests:
// every "math" line must be true, and the last one must give the answer.
{
  "category": "fractions",
  "title": "Fractions",
  "summary": "Same bottom number to add; multiply straight across; flip to divide.",
  "pages": [
    {
      "kind": "idea",
      "title": "Adding needs the same bottom",
      "text": "You can only add fractions whose bottom numbers (denominators) are the same. Change them to a common one first, then add the top numbers.",
      "example": {
        "problem": "1/2 + 1/3",
        "steps": [
          {
            "math": "1/2 = 3/6",
            "note": "Both 2 and 3 go into 6"
          },
          {
            "math": "1/3 = 2/6"
          },
          {
            "math": "3/6 + 2/6 = 5/6",
            "note": "Add the tops, keep the bottom"
          }
        ],
        "answer": "5/6"
      }
    },
    {
      "kind": "idea",
      "title": "Multiplying is straight across",
      "text": "To multiply fractions, multiply the tops together and the bottoms together, then simplify.",
      "example": {
        "problem": "2/3 × 3/4",
        "steps": [
          {
            "math": "2/3 × 3/4 = 6/12",
            "note": "Tops: 2 × 3, bottoms: 3 × 4"
          },
          {
            "math": "6/12 = 1/2",
            "note": "Simplify"
          }
        ],
        "answer": "1/2"
      }
    },
    {
      "kind": "trick",
      "title": "Dividing: flip the second, then multiply",
      "text": "Dividing by a fraction is multiplying by it upside down.",
      "example": {
        "problem": "3/4 ÷ 1/2",
        "steps": [
          {
            "math": "3/4 ÷ 1/2 = 3/4 × 2/1",
            "note": "Flip 1/2 into 2/1"
          },
          {
            "math": "3/4 × 2/1 = 6/4 = 3/2",
            "note": "Multiply, then simplify"
          }
        ],
        "answer": "3/2"
      }
    },
    {
      "kind": "watchOut",
      "title": "Never add straight across",
      "text": "1/2 + 1/3 is not 2/5: adding the tops and the bottoms gives a fraction smaller than 1/2, which cannot be right. Use a common denominator.",
      "example": {
        "problem": "1/4 + 1/2",
        "steps": [
          {
            "math": "1/2 = 2/4"
          },
          {
            "math": "1/4 + 2/4 = 3/4"
          }
        ],
        "answer": "3/4"
      }
    }
  ],
  "tip": "Adding: same denominator first. Dividing: flip the second fraction."
}
