// Leçon d'Apprendre (français). Les exemples sont vérifiés par les tests :
// chaque ligne "math" doit être juste, et la dernière doit donner la réponse.
{
  "category": "percentages",
  "title": "Pourcentages",
  "summary": "Pour cent veut dire sur 100 : pars de 10 % et de 1 %.",
  "pages": [
    {
      "kind": "idea",
      "title": "Sur cent",
      "text": "15 % veut dire 15 sur 100. Pour trouver 10 % d'un nombre, divise-le par 10 ; pour 1 %, divise-le par 100.",
      "example": {
        "problem": "10 % de 80",
        "steps": [
          {
            "math": "80 ÷ 10 = 8",
            "note": "10 %, c'est un dixième"
          }
        ],
        "answer": "8"
      }
    },
    {
      "kind": "trick",
      "title": "Le construire avec 10 % et 5 %",
      "text": "La plupart des pourcentages sont des sommes rapides de pourcentages faciles : 15 %, c'est 10 % plus 5 %, et 5 %, c'est la moitié de 10 %.",
      "example": {
        "problem": "15 % de 80",
        "steps": [
          {
            "math": "10 % de 80 = 8",
            "note": "10 %"
          },
          {
            "math": "5 % de 80 = 4",
            "note": "5 %, c'est la moitié de 10 %"
          },
          {
            "math": "8 + 4 = 12"
          }
        ],
        "answer": "12"
      }
    },
    {
      "kind": "trick",
      "title": "Inverser les nombres",
      "text": "x % de y, c'est pareil que y % de x : 8 % de 50, c'est 50 % de 8, soit 4.",
      "example": {
        "problem": "8 % de 50",
        "steps": [
          {
            "math": "8 % de 50 = 50 % de 8",
            "note": "Échange les nombres"
          },
          {
            "math": "50 % de 8 = 4",
            "note": "La moitié de 8"
          }
        ],
        "answer": "4"
      }
    },
    {
      "kind": "watchOut",
      "title": "La part, pas le reste",
      "text": "15 % de 80, c'est la part de 15 %, soit 12. Calculer les 85 % restants (68) est une erreur courante : lis bien ce que demande la question.",
      "example": {
        "problem": "25 % de 60",
        "steps": [
          {
            "math": "60 ÷ 4 = 15",
            "note": "25 %, c'est un quart"
          }
        ],
        "answer": "15"
      }
    }
  ],
  "tip": "Trouve d'abord 10 %, puis construis le pourcentage à partir de là."
}
