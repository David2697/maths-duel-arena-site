// Leçon d'Apprendre (français). Les exemples sont vérifiés par les tests :
// chaque ligne "math" doit être juste, et la dernière doit donner la réponse.
{
  "category": "powers",
  "title": "Puissances et racines",
  "summary": "Une puissance, c'est une multiplication répétée ; une racine la défait.",
  "pages": [
    {
      "kind": "idea",
      "title": "Une puissance multiplie un nombre par lui-même",
      "text": "Le petit nombre dit combien de fois le nombre apparaît dans la multiplication. 2⁵, c'est cinq 2 multipliés entre eux, pas 2 × 5.",
      "example": {
        "problem": "2⁵",
        "steps": [
          {
            "math": "2⁵ = 2 × 2 × 2 × 2 × 2",
            "note": "Cinq fois le 2"
          },
          {
            "math": "2 × 2 × 2 × 2 × 2 = 32"
          }
        ],
        "answer": "32"
      }
    },
    {
      "kind": "idea",
      "title": "Une racine revient en arrière",
      "text": "La racine carrée de 49 est le nombre qui, multiplié par lui-même, donne 49. Connaître les carrés jusqu'à 15² rend les racines rapides.",
      "example": {
        "problem": "√49",
        "steps": [
          {
            "math": "7 × 7 = 49",
            "note": "Quel nombre fois lui-même fait 49 ?"
          },
          {
            "math": "√49 = 7"
          }
        ],
        "answer": "7"
      }
    },
    {
      "kind": "trick",
      "title": "S'appuyer sur la puissance d'avant",
      "text": "Chaque puissance est la précédente multipliée encore une fois par le nombre : 3³ = 27, donc 3⁴ = 27 × 3.",
      "example": {
        "problem": "3⁴",
        "steps": [
          {
            "math": "3³ = 27",
            "note": "Une puissance que tu connais"
          },
          {
            "math": "27 × 3 = 81",
            "note": "Un 3 de plus"
          }
        ],
        "answer": "81"
      }
    },
    {
      "kind": "idea",
      "title": "La racine cubique revient en arrière trois fois",
      "text": "∛27 demande quel nombre, multiplié trois fois par lui-même, donne 27. Retiens les premiers cubes : 2³ = 8, 3³ = 27, 4³ = 64, 5³ = 125.",
      "example": {
        "problem": "∛27",
        "steps": [
          {
            "math": "3 × 3 × 3 = 27",
            "note": "Quel nombre, trois fois, donne 27 ?"
          },
          {
            "math": "∛27 = 3"
          }
        ],
        "answer": "3"
      }
    },
    {
      "kind": "watchOut",
      "title": "Ni fois, ni la moitié",
      "text": "Deux erreurs classiques : 6² fait 36, pas 6 × 2 = 12 ; et √64 fait 8, pas 64 ÷ 2 = 32.",
      "example": {
        "problem": "6²",
        "steps": [
          {
            "math": "6² = 6 × 6 = 36"
          }
        ],
        "answer": "36"
      }
    }
  ],
  "tip": "Une puissance répète la multiplication ; une racine retrouve le nombre répété."
}
